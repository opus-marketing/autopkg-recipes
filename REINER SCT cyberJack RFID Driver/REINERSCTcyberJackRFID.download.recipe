<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Description</key>
	<string>Downloads latest version of the REINER SCT cyberJack RFID Driver.</string>
	<key>Comment</key>
	<string>Use ARCH arm64 for Silicon version and x86_64 for Intel version</string>
	<key>Identifier</key>
	<string>com.github.opusmarketing.download.REINERSCTcyberJackRFID</string>
	<key>Input</key>
	<dict>
		<key>NAME</key>
		<string>cyberJack RFID</string>
		<key>ARCH</key>
		<string>arm64</string>
		<key>SEARCH_URL</key>
		<string>https://help.reiner-sct.com/de/support/solutions/articles/101000480002</string>
		<key>SEARCH_PATTERN</key>
        <string>(?P&lt;DOWNLOAD_URL&gt;https://support.reiner-sct.de/downloads/MAC/pcsc-cyberjack_(?P&lt;version&gt;.*?)-(?P&lt;ARCH&gt;.*?)-signed.pkg)</string>
	</dict>
	<key>MinimumVersion</key>
	<string>0.2.1</string>
	<key>Process</key>
	<array>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>re_pattern</key>
				<string>%SEARCH_PATTERN%</string>
				<key>url</key>
				<string>%SEARCH_URL%</string>
			</dict>
			<key>Processor</key>
			<string>URLTextSearcher</string>
		</dict>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>url</key>
				<string>%DOWNLOAD_URL%</string>
			</dict>
			<key>Processor</key>
			<string>URLDownloader</string>
		</dict>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>expected_authority_names</key>
				<array>
					<string>Developer ID Installer: REINER Kartengerate GmbH und Co. KG (5A7M4P6EPT)</string>
					<string>Developer ID Certification Authority</string>
					<string>Apple Root CA</string>
				</array>
				<key>input_path</key>
				<string>%pathname%</string>
			</dict>
			<key>Processor</key>
			<string>CodeSignatureVerifier</string>
		</dict>
		<dict>
			<key>Processor</key>
			<string>EndOfCheckPhase</string>
		</dict>
	</array>
</dict>
</plist>
